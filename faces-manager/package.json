{
  "name": "faces-manager",
  "version": "1.0.0",
  "description": "FACES Media Station Manager – discover and control multiple Pi stations on the LAN",
  "main": "main.js",
  "author": "FACES",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.faces.manager",
    "productName": "FACES Manager",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
