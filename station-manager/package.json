{
  "name": "station-manager",
  "version": "3.0.1",
  "description": "LZ Media Station Manager – discover and control multiple Pi stations on the LAN",
  "main": "main.js",
  "author": "Lars Zumpe Medienproduktion",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/larszu/lz-media-station.git",
    "directory": "station-manager"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "de.zumpelars.station-manager",
    "productName": "LZ Station Manager",
    "files": [
      "main.js",
      "preload.js",
      "alarme.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
